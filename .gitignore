# ==========================================
# Personal Health Companion
# Git Ignore
# ==========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.env/

# Python tools
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Environment / Secrets ----------
.env
.env.*
!.env.example

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- Generated Data ----------
data/raw/*
data/processed/*
data/simulated/*

# Keep folder structure in Git
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/simulated/.gitkeep

# ---------- AI / ML Generated Files ----------
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.h5
*.keras

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Experiments ----------
experiments/plots/*
experiments/results/*

!experiments/plots/.gitkeep
!experiments/results/.gitkeep

# ---------- Node / React ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build files
dist/
build/

# ---------- VS Code ----------
.vscode/
!.vscode/extensions.json

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Logs ----------
*.log

# ---------- Temporary files ----------
*.tmp
*.temp
*.swp